# Copy to .env and fill in. .env is gitignored.
#
# Compose checks every required variable in the file, not only the ones for the
# service being started — so even `docker compose up -d db` in dev needs
# SESSION_SECRET and ADMIN_PASSWORD set, not just POSTGRES_PASSWORD.

# --- database ---
POSTGRES_PASSWORD=change-me
# Dev only: the app container builds its own from POSTGRES_PASSWORD.
DATABASE_URL=postgres://bookshelf:change-me@localhost:5433/bookshelf

# --- app ---
# openssl rand -base64 32
SESSION_SECRET=
ORIGIN=http://localhost:3001

# Skip sign-in entirely. For a single-user server on a network you trust:
# anything that can reach the port can read, edit and delete without a
# password. The admin user below still has to exist; you just walk past it.
AUTH_DISABLED=false

# Where downloaded cover art is written. Absolute in the container,
# and absolute in dev too: a relative path makes the bundler trace the whole
# project into the server build. In dev, point it at the gitignored ./data.
COVERS_DIR=/absolute/path/to/bookshelf/data/covers

# --- the first user (read once, when the database is empty) ---
# The name can be changed later in Settings; this only ever applies to
# creating the account, never to an existing one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Open Library ---
# Sent in the User-Agent, as Open Library asks: an email or a URL.
OPENLIBRARY_CONTACT=

# --- Google Books (optional) ---
# Cover fallback by ISBN. Works unauthenticated at this volume.
GOOGLE_BOOKS_API_KEY=

# --- container ports (compose only) ---
# Both services bind to 127.0.0.1 by default, and default off gameshelf's
# 3000/5432 so the two share a box.
# APP_BIND=127.0.0.1
# APP_PORT=3001
# DB_BIND=127.0.0.1
# DB_PORT=5433

# --- images (compose only) ---
# Pin to a commit sha to deploy something other than the newest build.
# BOOKSHELF_IMAGE=ghcr.io/iron-jay/bookshelf
# BOOKSHELF_TAG=latest
